# ---- Server ----
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed frontend origins (for CORS)
CLIENT_ORIGIN=http://localhost:3000

# ---- Database ----
# MongoDB Atlas connection string (or local mongodb://127.0.0.1:27017/private-chat)
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/private-chat

# ---- Sessions ----
# Long random string, e.g. `openssl rand -hex 64`
SESSION_SECRET=change-me-to-a-long-random-string
# Session lifetime in milliseconds (default 7 days)
SESSION_TTL_MS=604800000

# ---- Message retention ----
# Maximum number of messages retained (50 lakh = 5,000,000)
MAX_MESSAGES=5000000
# How many messages to delete per cleanup batch once the cap is exceeded
RETENTION_BATCH_SIZE=500
# Run the retention check every N inserts (reduces overhead vs. checking every insert)
RETENTION_CHECK_INTERVAL=50

# ---- The two (and only two) authorized users ----
USER1_EMAIL=alice@example.com
USER1_PASSWORD=change-me-strong-password-1
USER1_NAME=Alice

USER2_EMAIL=bob@example.com
USER2_PASSWORD=change-me-strong-password-2
USER2_NAME=Bob
